<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ game.summary }}">
  <meta name="theme-color" content="#1f6546">
  <meta property="og:title" content="{{ game.title }} — Acervo de Jogos e Quebra-Cabeças">
  <meta property="og:description" content="{{ game.summary }}">
  <meta property="og:type" content="article">
  <meta property="og:image" content="{% if game.image.startswith('http') %}{{ game.image }}{% else %}../images/{{ game.image }}{% endif %}">
  <title>{{ game.title }} — Acervo de Jogos e Quebra-Cabeças</title>
  <link rel="icon" href="../images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="../css/site.css">
  <script type="application/ld+json">{{ json_ld | safe }}</script>
</head>
<body class="detail-page">
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  <header class="site-header compact-header">
    <div class="shell header-inner">
      <a class="brand" href="../index.html" aria-label="Voltar à página inicial do acervo">
        <span class="brand-mark" aria-hidden="true">◇</span>
        <span><strong>Acervo de desafios</strong><small>jogar, observar, conversar</small></span>
      </a>
      <nav class="main-nav" aria-label="Navegação principal">
        <a href="../index.html#jogos">Todos os jogos</a>
        <a href="../index.html#como-usar">Como usar</a>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <div class="shell breadcrumb" aria-label="Navegação estrutural">
      <a href="../index.html">Início</a><span aria-hidden="true">/</span><a href="../index.html#jogos">Jogos</a><span aria-hidden="true">/</span><span aria-current="page">{{ game.title }}</span>
    </div>

    <article>
      <header class="detail-hero">
        <div class="shell detail-hero-grid">
          <div class="detail-copy">
{% if game.student_created is defined and game.student_created %}<span class="student-created-badge detail"><span aria-hidden="true">✦</span> Jogo criado por estudantes</span>{% endif %}
            <span class="category-badge standalone">{{ game.category_label }}</span>
            <h1>{{ game.title }}</h1>
            {% if game.catalog_alias is defined and game.catalog_alias %}<p class="catalog-alias detail-alias">{{ game.catalog_alias }}</p>{% endif %}
            <p class="detail-subtitle">{{ game.subtitle }}</p>
            <p class="detail-summary">{{ game.summary }}</p>
            <div class="detail-actions">
              <a class="button button-primary" href="#como-experimentar">Como experimentar</a>
              <button class="button button-quiet share-button" type="button" data-share-title="{{ game.title }}">Compartilhar</button>
            </div>
          </div>
          <figure class="detail-image">
            <img src="{% if game.image.startswith('http') %}{{ game.image }}{% else %}../images/{{ game.image }}{% endif %}" alt="{{ game.image_alt }}" width="960" height="640" decoding="async">
          </figure>
        </div>
      </header>

      <div class="shell detail-layout">
        <aside class="fact-panel" aria-label="Informações rápidas">
          <h2>Antes de começar</h2>
          <dl class="fact-list">
            <div><dt>Objetivo</dt><dd>{{ game.objective }}</dd></div>
            <div><dt>Participantes</dt><dd>{{ game.players }}</dd></div>
            <div><dt>Tempo estimado</dt><dd>{{ game.time }}</dd></div>
            <div><dt>Dificuldade</dt><dd>{{ game.difficulty }}</dd></div>
            <div><dt>Tipo de orientação</dt><dd>{{ game.mode }}</dd></div>
          </dl>
          <p class="fact-note">O tempo é apenas uma referência. Familiaridade, condições de acesso e forma de mediação alteram bastante a experiência.</p>
        </aside>

        <div class="detail-content">
          <section class="content-block" aria-labelledby="desafio-title">
            <p class="eyebrow">O desafio</p>
            <h2 id="desafio-title">O que observar neste jogo</h2>
            {% for paragraph in game.intro %}<p>{{ paragraph }}</p>{% endfor %}
          </section>

          {% if game.student_created is defined and game.student_created %}
          <section class="content-block student-creation-block" aria-labelledby="student-creation-title">
            <p class="eyebrow">Autoria estudantil</p>
            <h2 id="student-creation-title">Sobre a criação do jogo</h2>
            <div class="student-credit-panel">
              <p>{{ game.creator_context }}</p>
              <dl class="student-credit-list">
                <div><dt>Autoria</dt><dd>{% for creator in game.student_creators %}{{ creator }}{% if not loop.last %}; {% endif %}{% endfor %}</dd></div>
                <div><dt>Disciplina</dt><dd>{{ game.school_subject }}</dd></div>
                <div><dt>Professora responsável</dt><dd>{{ game.teacher }}</dd></div>
              </dl>
            </div>
          </section>
          <section class="content-block student-rules-block" aria-labelledby="student-rules-title">
            <p class="eyebrow">Espaço reservado</p>
            <h2 id="student-rules-title">Resumo das regras e outros detalhes</h2>
            <div class="reserved-details">
              <p>{{ game.rules_summary }}</p>
              <p>Este espaço será preenchido com as regras, a preparação da partida, os personagens, as ações possíveis, os objetivos e outros detalhes confirmados com as autoras.</p>
            </div>
          </section>
          {% endif %}

          <section class="content-block" id="como-experimentar" aria-labelledby="steps-title">
            <p class="eyebrow">Guia de ação</p>
            <h2 id="steps-title">Como experimentar</h2>
            <ol class="instruction-list">
              {% for step in game.steps %}
              <li><span>{{ loop.index }}</span><div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></li>
              {% endfor %}
            </ol>
          </section>

          <section class="content-block" aria-labelledby="skills-title">
            <p class="eyebrow">Possibilidades educativas</p>
            <h2 id="skills-title">O que a atividade pode mobilizar</h2>
            <div class="skills-grid">
              {% for skill in game.skills %}
              <article><h3>{{ skill.title }}</h3><p>{{ skill.text }}</p></article>
              {% endfor %}
            </div>
            <p class="qualification-note">“Pode mobilizar” não significa “desenvolve automaticamente”. A experiência depende da proposta, da repetição, do diálogo e das condições de participação.</p>
          </section>

          <section class="content-block" aria-labelledby="mediation-title">
            <p class="eyebrow">Mediação</p>
            <h2 id="mediation-title">Perguntas que mantêm o problema aberto</h2>
            <ul class="question-list">
              {% for question in game.mediation %}<li>{{ question }}</li>{% endfor %}
            </ul>
          </section>

          <section class="content-block" aria-labelledby="access-title">
            <p class="eyebrow">Participação e acessibilidade</p>
            <h2 id="access-title">Formas de adaptar sem retirar o desafio</h2>
            <ul class="check-list">
              {% for adaptation in game.adaptations %}<li>{{ adaptation }}</li>{% endfor %}
            </ul>
          </section>

          <aside class="care-card" aria-labelledby="care-title">
            <div class="care-icon" aria-hidden="true">!</div>
            <div><h2 id="care-title">Cuidado com o exemplar e com a informação</h2><p>{{ game.care }}</p></div>
          </aside>

          {% if game.sources %}
          <section class="content-block sources-block" aria-labelledby="sources-title">
            <p class="eyebrow">Referências</p>
            <h2 id="sources-title">Fontes para conferir e aprofundar</h2>
            <ul class="source-list">
              {% for source in game.sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }} <span aria-hidden="true">↗</span></a></li>{% endfor %}
            </ul>
          </section>
          {% endif %}
        </div>
      </div>
    </article>

    <section class="related-section" aria-labelledby="related-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Continue explorando</p><h2 id="related-title">Desafios relacionados</h2></div>
          <a class="text-link" href="../index.html#jogos">Ver coleção completa →</a>
        </div>
        <div class="related-grid">
          {% for related in related_games %}
          <a class="related-card" href="{{ related.id }}.html">
            <img src="{% if related.image.startswith('http') %}{{ related.image }}{% else %}../images/{{ related.image }}{% endif %}" alt="" width="360" height="240" loading="lazy" decoding="async">
            <span><small>{{ related.category_label }}</small><strong>{{ related.title }}</strong></span>
          </a>
          {% endfor %}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div><strong>Acervo de Jogos e Quebra-Cabeças</strong><p>Catálogo educativo para consulta, mediação e experimentação.</p></div>
      <a class="text-link footer-link" href="../index.html#jogos">← Voltar aos jogos</a>
    </div>
  </footer>

  <div class="toast" id="share-toast" role="status" aria-live="polite" hidden>Link copiado.</div>
  <script src="../js/site.js" defer></script>
</body>
</html>
